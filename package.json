{
  "name": "eslint-config-cityssm",
  "version": "54.0.0",
  "description": "ESLint rules used in the City of Sault Ste. Marie's TypeScript projects.",
  "keywords": [
    "eslint",
    "eslint-config",
    "eslintconfig",
    "html-eslint",
    "eslint-plugin",
    "eslint-plugin-browser-security",
    "eslint-plugin-eslint-comments",
    "eslint-plugin-express-security",
    "eslint-plugin-jsdoc",
    "eslint-plugin-n",
    "eslint-plugin-node-security",
    "eslint-node-test",
    "eslint-plugin-package-json",
    "eslint-plugin-perfectionist",
    "eslint-plugin-promise",
    "eslint-plugin-regexp",
    "eslint-plugin-runtime-cleanup",
    "eslint-plugin-secure-coding",
    "eslint-plugin-sonarjs",
    "eslint-plugin-sqlite-security",
    "eslint-plugin-unicorn",
    "eslint-plugin-write-good-comments-2",
    "typescript-eslint"
  ],
  "homepage": "https://github.com/cityssm/eslint-config-cityssm#readme",
  "bugs": {
    "url": "https://github.com/cityssm/eslint-config-cityssm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cityssm/eslint-config-cityssm.git"
  },
  "license": "Unlicense",
  "author": "The Corporation of the City of Sault Ste. Marie",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./eslint.config.js",
    "./eslint.config.js": "./eslint.config.js",
    "./eslint.packageConfig.js": "./eslint.packageConfig.js",
    "./exports": "./exports.js",
    "./exports.js": "./exports.js",
    "./packageConfig": "./eslint.packageConfig.js"
  },
  "main": "eslint.config.js",
  "files": [
    "lists/*",
    "eslint.config.*",
    "eslint.packageConfig.*",
    "exports.*"
  ],
  "scripts": {
    "coverage": "c8 node ./test/runEslint.js",
    "performance": "cross-env TIMING=20 eslint samples",
    "samples:css": "eslint --debug \"samples/*.css\"",
    "samples:ejs": "eslint --debug samples/*.ejs",
    "samples:html": "eslint --debug samples/*.html",
    "samples:json": "eslint --debug samples/*.json",
    "samples:md": "eslint --debug samples/*.md",
    "samples:ts": "eslint --debug samples/*.ts",
    "test": "node ./test/runEslint.js"
  },
  "dependencies": {
    "@eslint/core": "^1.2.1",
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@html-eslint/eslint-plugin": "^0.66.1",
    "@html-eslint/parser": "^0.66.1",
    "eslint": "^10.11.0",
    "eslint-config-love": "^157.0.0",
    "eslint-node-test": "^0.4.0",
    "eslint-plugin-browser-security": "^2.1.9",
    "eslint-plugin-express-security": "^3.2.4",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-node-dependencies": "^2.2.0",
    "eslint-plugin-node-security": "^5.6.7",
    "eslint-plugin-package-json": "^1.10.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-runtime-cleanup": "^2.0.2",
    "eslint-plugin-secure-coding": "^5.4.12",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-sqlite-security": "^0.1.11",
    "eslint-plugin-unicorn": "^76.0.0",
    "eslint-plugin-write-good-comments-2": "^1.2.14",
    "typescript-eslint": "^8.70.1"
  },
  "devDependencies": {
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/node": "^26.6.2",
    "prettier-config-cityssm": "^2.2.0"
  }
}
